//SISO

module siso(
    input clk,
    input rst,
    input d,
    output out
);

reg [2:0] shift;

always @(posedge clk) begin
    if (rst)
        shift <= 3'b000;
    else begin
        shift[0] <= d;
        shift[1] <= shift[0];
        shift[2] <= shift[1];
    end
end

assign out = shift[2];

endmodule
