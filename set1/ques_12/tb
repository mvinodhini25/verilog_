//SISO
module tb;
wire out;
reg clk,rst,d;

siso s1(.clk(clk),.rst(rst),.d(d),.out(out));

initial begin
clk = 0;
forever #10 clk = ~clk;
end

initial begin
rst =1;
#10;

rst=0;
d=1;
#20;
d=1;
#20;
d=0;
#80;
$finish;
end

initial begin
$monitor("time=%0t,clk=%0b,rst=%0b,d=%0b,out=%0b",$time,clk,rst,d,out);
end

endmodule
