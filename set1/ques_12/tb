module tb;
wire out;
reg [7:0]d;
reg clk,rst;

piso p1(.d(d),.clk(clk),.rst(rst),.out(out));

initial begin 
clk = 0;
forever #10clk = ~clk;
end

initial begin
rst=1;
#20;

rst=0;
d=8'd3;
#80;

$finish;
end

initial begin
$monitor("time=%0t,clk=%0d,rst=%0d,d=%0b,out=%0b",$time,clk,rst,d,out);
end

endmodule
