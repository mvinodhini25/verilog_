module tb;
wire y;
reg clk,rst,load;

seq s1(.load(load),.clk(clk),.rst(rst),.y(y));

initial begin
clk = 0;
forever #10 clk = ~clk;
end

initial begin
rst = 1;
load = 1;
#20;

rst = 0;
load = 0;
#20;
load = 1;
#20;
load = 0;
#20;
load = 1;
#20;
load = 1;
#20;

$finish;
end

initial begin
$monitor("time=%0t,clk=%0b,rst=%0b,load=%0b,y=%0b",$time,clk,rst,load,y);
end

endmodule 

