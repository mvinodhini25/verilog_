//SEQUENCE DETECTOR

module seq(input a,input clk,rst,output y);

reg [1:0]state,next;
parameter s1=2'd0,s2=2'd1,s3=2'd2,s4=2'd3;

always@(posedge clk) begin
if(rst)
state <= s1;
else
state <= next;
end

always@(*) begin
case(state) 
s1: begin
  if(a)
	next = s2;
  else
	next = s1;
end

s2: begin
  if(a)
	next = s1;
  else
	next = s3;
end

s3: begin
  if(a)
	next = s4;
  else
	next = s2;
end

s4: begin
  if(a)
	next = s1;
  else 
	next = s2;
end
default : next = s1;
endcase
end

assign y = (state == s4);

endmodule
