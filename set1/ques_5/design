module fa(input a,b,cin,output s,cout);
        assign s = a^b^cin;
        assign cout = (a&b)|(cin&(a^b));
endmodule

module rca(input [3:0]a,b,input cin,output [3:0]s,output cout,output [4:0]carry);
genvar i;
generate
   assign carry[0] = cin;
     for(i=0;i<4;i=i+1) begin:RCA
fa f1(.a(a[i]), .b(b[i]), .cin(carry[i]), .s(s[i]), .cout(carry[i+1]));	
    assign cout = carry[3];
  end
endgenerate

endmodule

