module master(
input clk,
input rst,
input write,
input in,
input [7:0] addr,
input [7:0] wdata,

input pready,
input [7:0] prdata,


output reg pselx,penable,pwrite,
output reg [7:0] paddr,
output reg [7:0] pwdata,
output reg [7:0] rdata
);

localparam IDLE =2'b00,SETUP=2'b01,ACCESS=2'b10;

reg [1:0] state,next;

// STATE LOGIC
always @(posedge clk) begin
if(rst)  begin
state<=IDLE;
rdata<=8'b0;
end

else begin
state<=next;
if(state==ACCESS && pready && !pwrite)
	rdata<=prdata;
end
end

//NEXTSTATE LOGIC
always @(*) begin
case(state)
IDLE: begin
if(in) 
next=SETUP;
else
next=IDLE;
end
SETUP: begin
next=ACCESS;
end
ACCESS: begin
if(pready) begin
if(in)
next=SETUP;
else
next=IDLE;
end
else 
next=ACCESS;
end
default:
	next=IDLE;
endcase
end

//OUTPUT LOGIC
always @(*) begin
    pselx    = 0;
    penable = 0;
    pwrite  = 0;
    paddr   = 0;
    pwdata  = 0;

    case(state)
        IDLE: begin
            pselx = 0;
            penable = 0;
        end

        SETUP: begin
            pselx = 1;
            penable = 0;
            pwrite = write;
            paddr = addr;
            pwdata = wdata;
        end

        ACCESS: begin
            pselx = 1;
            penable = 1;
            pwrite = write;
            paddr = addr;
            pwdata = wdata;
        end
	default: begin
		pselx=0;
		penable=0;
	end

    endcase
end
endmodule
