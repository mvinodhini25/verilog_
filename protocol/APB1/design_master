module master(input clk, rst, input [7:0]wdata, addr, prdata, input pready, in, write, output reg [7:0]paddr, output reg pselx, penable, output reg pwrite, output  reg [7:0]pwdata, rdata);

reg [1:0]state;
reg write_reg;

localparam idle=2'd0, setup=2'd1, access=2'd2;

always@(posedge clk) begin
if(!rst) begin
state <= idle;
paddr <= 8'd0;
pselx <= 1'd0;
penable <= 1'd0;
pwdata <= 8'd0;
rdata <= 8'd0;
write_reg <= 1'b0;
end
else begin
case(state)

idle : begin
        pselx <= 0;
        if(in) begin
          paddr <= addr;
          pwdata <= wdata;
	  pwrite <= write;
          write_reg <= write;
          state <= setup;
        end
        else
          state <= idle;
end

setup : begin
        pselx <= 1;
        penable <= 0;

        state <= access;
end

access : begin
        pselx <= 1;
        penable <= 1;

        if(pready) begin
                pselx <= 0;
                penable <= 0;
                state <= idle;
                if(!write_reg)
                    rdata <= prdata;   
        end
        else
                state <= access;
end
        default : state <= idle;
endcase
end
end

endmodule
