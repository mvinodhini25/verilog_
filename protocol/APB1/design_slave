

module slave(input clk, rst, input [7:0]pwdata, paddr, input pselx, penable, pwrite, output reg pready, output [7:0]prdata);


reg [7:0] mem;
reg [1:0] wait_cnt;
assign prdata = mem;

always@(posedge clk) begin
	if(!rst) begin


		pready <= 1'd0;

		mem <= 8'd0;
		wait_cnt <= 2'd0;
	end
	else begin
	
		if(pselx && penable) begin
			if(wait_cnt >= wait_cycle) begin
				wait_cnt <= wait_cnt;
	
				if(pwrite)
					mem <= pwdata;

			end
			else begin
				wait_cnt <= wait_cnt +1;
			end

end

		end
		else begin
			wait_cnt <= 2'd0;
		end
	end
end
always @(*) begin
    pready = 1'b0;
    prdata = 8'b0;

    if(pselx && penable) begin
        pready = 1'b1;

        if(!pwrite)
            prdata = mem;
    end
end

endmodule
