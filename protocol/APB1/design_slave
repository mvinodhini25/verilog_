module slave(input clk, rst, input [7:0]pwdata, paddr, input pselx, penable, pwrite, output reg pready, output reg [7:0]prdata);

reg [7:0] mem;
reg [1:0] wait_cnt;

always@(posedge clk) begin
	if(!rst) begin
		prdata <= 8'd0;
		pready <= 1'd0;
		mem <= 8'd0;
		wait_cnt <= 2'd0;
	end
	else begin
	
		if(pselx && penable) begin
			if(wait_cnt < 2'd2) begin
				pready <= 0;
				wait_cnt <= wait_cnt+1;
			end
			else begin
				pready <= 1;
				wait_cnt <= 2'd0;
	
				if(pwrite)
					mem <= pwdata;
				else
					prdata <= mem;
			end
		end
		else begin
			pready <= 0;
			wait_cnt <= 2'd0;
		end
	end
end

endmodule	
		
