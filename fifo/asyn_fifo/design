module fifo(
//WRITE 
input wr_clk,wr_rst,wr_en,
input [7:0]data_in,
output full,
//READ
input rd_clk,rd_rst,rd_en,
output empty,
output reg [7:0] data_out
);

reg [7:0]mem[3:0];

//WRITE
reg [2:0]wr_ptr, wr_gray, wr_ff1,wr_ff2; 
wire [2:0] wr_ptr_nxt, wr_gray_nxt;


//READ 
reg [2:0]rd_ptr, rd_gray, rd_ff1, rd_ff2;
wire [2:0] rd_ptr_nxt, rd_gray_nxt;

//WRITE
assign wr_ptr_nxt = wr_ptr + ((wr_en && !full)?1'b1:1'b0);
assign wr_gray_nxt = wr_ptr_nxt ^ (wr_ptr_nxt>>1);

always@(posedge wr_clk or wr_rst) begin
if(wr_rst) begin
rd_ff1 <= 3'd0;
rd_ff2 <= 3'd0;
end
else begin
rd_ff1 <= rd_gray_nxt;
rd_ff2 <= rd_ff1;
end
end

always@(posedge wr_clk or posedge wr_rst) begin
if(wr_rst) begin
wr_ptr <= 3'd0;
wr_gray <= 3'd0;
end
else begin
if(wr_en && !full)begin
mem[wr_ptr] <= data_in;
end
wr_ptr <= wr_ptr_nxt;
wr_gray <= wr_gray_nxt;
end
end

//READ
assign rd_ptr_nxt = rd_ptr + ((rd_en && !empty)?1'b1:1'b0);
assign rd_gray_nxt = rd_ptr_nxt ^ (rd_ptr_nxt>>1);

always@(posedge rd_clk or posedge rd_rst) begin
if(rd_rst) begin
wr_ff1 <= 3'd0;
wr_ff2 <= 3'd0;
end
else begin
wr_ff1 <= wr_gray_nxt;
wr_ff2 <= wr_ff1;
end
end      

always@(posedge rd_clk or rd_rst) begin
if(rd_rst) begin
rd_ptr <= 3'd0;
rd_gray <= 3'd0;
end
else begin
if(rd_en && !empty)begin
data_out <= mem[rd_ptr];
end
rd_ptr <= rd_ptr_nxt;
rd_gray <= rd_gray_nxt;
end
end 

assign full = ({~rd_ff2[2],rd_ff2[1:0]} == wr_ptr_nxt);
assign empty = (rd_ptr == wr_ff2);


endmodule
