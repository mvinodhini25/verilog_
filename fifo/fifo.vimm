module fifo(
    input clk,
    input rst,
    input [7:0] data_in,
    input wr_en,
    input re_en,
    output full,
    output empty,
    output reg [7:0] data_out
);

reg [1:0] wr_ptr, re_ptr;
reg [7:0] mem [3:0];
reg [2:0] count;

always @(posedge clk) begin
    if (rst) begin
        wr_ptr   <= 2'd0;
        re_ptr   <= 2'd0;
        count    <= 3'd0;
        data_out <= 8'd0;
    end
    else begin

        
        if (wr_en && !full) begin
            mem[wr_ptr] <= data_in;
            wr_ptr <= wr_ptr + 1;
        end

        
        if (re_en && !empty) begin
            data_out <= mem[re_ptr];
            re_ptr <= re_ptr + 1;
        end

                if (wr_en && !full && !(re_en && !empty))
            count <= count + 1;
        else if (re_en && !empty && !(wr_en && !full))
            count <= count - 1;
        
    end
end

assign full  = (count == 3'd4);
assign empty = (count == 3'd0);

endmodule
