module top_module ( 
    input p1a, p1b, p1c, p1d, p1e, p1f,
    output p1y,
    input p2a, p2b, p2c, p2d,
    output p2y );
    wire A,B,C,D;
    assign A = p1a*p1b*p1c;
    assign B = p1d*p1e*p1f;
    assign C = p2a*p2b;
    assign D = p2c*p2d;
    assign p1y = A|B;
    assign p2y = C|D;
endmodule
