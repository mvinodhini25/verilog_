module alu(input [2:0]a,
input [2:0]b,
output reg[3:0]add,
output reg[3:0]sub,
output reg[3:0]multiple,
output reg[3:0]division);

task add1;
input [2:0]x,y;
output [3:0]z;
begin 
z=x+y;
end
endtask

task sub1;
input [2:0]x,y;
output [3:0]z;
begin
z=x-y;
end
endtask

task multiple1;
input [2:0]x,y;
output [3:0]z;
begin
z=x*y;
end
endtask

task division1;
input [2:0]x,y;
output [3:0]z;
begin
z=x/y;
end
endtask

always@(*) begin 
add1(a,b,add);
sub1(a,b,sub);
multiple1(a,b,multiple);
division1(a,b,division);
end

endmodule
